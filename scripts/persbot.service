# user service
[Unit]
Description=Persbot Service
Documentation=https://github.com/PersbotDevs/Persbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/persbot
ExecStart=/usr/bin/sh -c '/usr/bin/persbot run || { /usr/bin/persbot init && /usr/bin/persbot run; }'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=persbot-%u
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
